APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Realtime. Isi kredensial Pusher lalu set BROADCAST_CONNECTION=pusher.
# Selama VITE_PUSHER_APP_KEY kosong, aplikasi tetap jalan tanpa realtime.
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME="https"
PUSHER_APP_CLUSTER="ap1"

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Login. Satu-satunya cara masuk aplikasi ini adalah akun Google, jadi ketiga
# nilai di bawah wajib diisi. Ambil dari Google Cloud Console > Credentials >
# OAuth client ID (tipe "Web application"), dan daftarkan GOOGLE_REDIRECT
# persis seperti yang tertulis di sini sebagai Authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT="${APP_URL}/auth/google/callback"

# Matikan sementara kalau login gagal dengan access_denied karena izin Calendar
# belum beres di Google Cloud Console. Login tetap jalan, tapi tidak ada refresh
# token untuk Calendar sampai ini dinyalakan lagi dan user masuk ulang.
GOOGLE_CALENDAR_SCOPE=true

# Verifikasi robot di layar masuk (Cloudflare Turnstile). Biarkan mati sampai
# kuncinya siap: pintu masuknya tetap bekerja, cuma tanpa lapisan ini. Ambil
# kuncinya di dash.cloudflare.com > Turnstile > Add widget (mode Managed), dan
# daftarkan seluruh hostname yang dipakai, termasuk yang lokal.
#
# Untuk mencoba tanpa akun: site key 1x00000000000000000000AA dan secret
# 1x0000000000000000000000000000000AA selalu lolos; ganti awalannya jadi 2x
# untuk memaksa kegagalan.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Penulis isi pasal MoU dan rincian pekerjaan. Kuncinya diambil di
# console.groq.com > API Keys. Dikosongkan berarti tombol "Tulis dengan AI"
# tidak muncul dan semuanya diketik manual seperti biasa.
#
# Katalog model Groq berganti cukup sering dan yang lama ditolak dengan 404,
# jadi cocokkan dengan daftar di console.groq.com > Models kalau tiba-tiba gagal.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
